<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SS MediaOS SMS Gateway"
            android:textColor="#101B35"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Manage your secure gateway connection"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF">

            <!-- Keep this view because GatewaySettingsActivity.kt references its ID.
                 It remains hidden from users; the app sets the server URL internally. -->
            <EditText
                android:id="@+id/serverUrlInput"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Company API Key"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/apiTokenInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter Company API Key"
                android:inputType="textPassword"
                android:singleLine="true"
                android:autofillHints="password"
                android:importantForAutofill="yes" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Your API key is masked on screen."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Device ID"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/deviceIdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Device ID is generated by the app"
                android:inputType="text"
                android:singleLine="true"
                android:enabled="false"
                android:focusable="false"
                android:autofillHints="no" />

            <Button
                android:id="@+id/saveSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Save Settings"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/testConnectionButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Test Server Connection"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/activateDeviceButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#0F766E"
                android:text="Connect Device"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/connectionStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Connection status: Not tested"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/activationStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F1F5F9"
                android:padding="12dp"
                android:text="Device status: NOT ACTIVATED"
                android:textColor="#B45309"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="SS MediaOS"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
