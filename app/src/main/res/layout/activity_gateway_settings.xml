<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SS MediaOS SMS Gateway"
            android:textColor="#101B35"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Manage your secure gateway connection"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF">

            <!-- Internal fields: retained for Kotlin compatibility, hidden from users. -->
            <EditText
                android:id="@+id/serverUrlInput"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/deviceIdInput"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:enabled="false"
                android:focusable="false" />

            <!-- Company API Key -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Company API Key"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/apiTokenInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter Company API Key"
                android:inputType="textPassword"
                android:singleLine="true"
                android:autofillHints="password" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Your API key is masked on screen."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <!-- Organization Code -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Organization Code"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/organizationCodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter Organization Code"
                android:inputType="textCapCharacters"
                android:singleLine="true"
                android:importantForAutofill="no" />

            <!-- Registered Mobile -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Registered Mobile Number"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/registeredMobileInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter registered mobile number"
                android:inputType="phone"
                android:singleLine="true"
                android:autofillHints="phone" />

            <!-- Verify organization and mobile -->
            <Button
                android:id="@+id/verifyMobileButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="Verify Organization &amp; Mobile"
                android:textAllCaps="false" />

            <!-- Organization name -->
            <TextView
                android:id="@+id/organizationNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#F8FAFC"
                android:padding="12dp"
                android:text="Organization Name: Not verified"
                android:textColor="#334155"
                android:textSize="14sp" />

            <!-- Verification status -->
            <TextView
                android:id="@+id/organizationStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFF7ED"
                android:padding="12dp"
                android:text="Organization Verification: PENDING"
                android:textColor="#9A3412"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- SIM status -->
            <TextView
                android:id="@+id/simStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F1F5F9"
                android:padding="12dp"
                android:text="SIM status: Not checked"
                android:textColor="#475569"
                android:textSize="14sp" />

            <!-- Save -->
            <Button
                android:id="@+id/saveSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Save Settings"
                android:textAllCaps="false" />

            <!-- Test connection -->
            <Button
                android:id="@+id/testConnectionButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Test Server Connection"
                android:textAllCaps="false" />

            <!-- Activate device -->
            <Button
                android:id="@+id/activateDeviceButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#0F766E"
                android:text="Verify/Connect Device"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <!-- Connection status -->
            <TextView
                android:id="@+id/connectionStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Connection status: Not tested"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <!-- Device activation status -->
            <TextView
                android:id="@+id/activationStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F1F5F9"
                android:padding="12dp"
                android:text="Device status: NOT ACTIVATED"
                android:textColor="#B45309"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="SS MediaOS"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
